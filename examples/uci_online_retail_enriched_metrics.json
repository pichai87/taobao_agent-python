      "condition": {"field": "record_type", "value": "positive"},
      "unit": "件"
    }
  },
  {
    "name": "正向交易行数",
    "table": "retail_lines",
    "field": "line_count",
    "source": "UCI Online Retail；只计正向且数量、单价均为正的明细；一行不等于一笔订单",
